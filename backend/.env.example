# --- Serveur ---
PORT=4000
# URL publique de l'API (sert à construire l'URL des images uploadées)
PUBLIC_URL=http://localhost:4000
# URL du site Next.js (CORS + redirections Stripe)
FRONTEND_URL=http://localhost:3000

# --- Base de données SQLite ---
DATABASE_PATH=./data/boutique.db

# --- Sécurité admin ---
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMoi123!

# --- Paiement ---
# Part du prix demandée en acompte à la commande (0.10 = 10 %)
DEPOSIT_RATE=0.10
# Coordonnées bancaires affichées pour le virement de l'acompte
BANK_HOLDER=Votre société
BANK_IBAN=FR76 0000 0000 0000 0000 0000 000
BANK_BIC=XXXXFRPP
# Stripe (optionnel) : laisser vide pour désactiver le paiement de l'acompte par carte
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Contact affiché sur le site ---
SHOP_NAME=Mobil-Home Store
SHOP_PHONE=03 00 00 00 00
SHOP_EMAIL=contact@example.com
